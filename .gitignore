*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/
.env
.env.*
!.env.example
!.env.local.example
.python-version

# --- Node (если появятся вспомогательные скрипты) ---
node_modules/
npm-debug.log*

# --- Временное ---
*.tmp
*.bak
*.log
/tmp/
scratch/

