# =============================================================================
# .env.example — шаблон секретов проекта «ИИ-интервьюер».
# Скопируй в .env и заполни значения. .env в git НЕ коммитится.
# Порядок = порядок этапов из PRD (раздел 9): заводи по мере надобности.
# =============================================================================

# --- Общее ---
APP_ENV=development                 # development | production
SECRET_KEY=change-me                # общий секрет приложения
JWT_SECRET_KEY=change-me            # подпись JWT для внутренних ролей
MAGIC_LINK_SECRET=change-me         # подпись одноразовых ссылок кандидата (Р20)

# =============================================================================
# ЭТАП 1 — ядро оценки. Минимум для запуска: LLM + Postgres.
# =============================================================================

# --- PostgreSQL ---
DATABASE_URL=postgresql+psycopg://interviewer:interviewer@localhost:5432/interviewer

# --- LLM: выбери ОДИН провайдер (152-ФЗ, данные в РФ) ---
LLM_PROVIDER=yandexgpt              # yandexgpt | gigachat

# YandexGPT Pro (сервисный аккаунт Yandex Cloud)
YANDEX_API_KEY=                     # API-ключ сервисного аккаунта
YANDEX_FOLDER_ID=                   # id каталога Yandex Cloud
YANDEX_GPT_MODEL=gpt://<folder_id>/yandexgpt/latest

# GigaChat (альтернатива)
GIGACHAT_CREDENTIALS=               # Authorization Key (base64 client_id:client_secret)
GIGACHAT_SCOPE=GIGACHAT_API_PERS    # _PERS (физлицо) | _CORP (юрлицо)

# =============================================================================
# ЭТАП 2 — интервью кандидата: очередь, TTS, хранилище записей.
# =============================================================================

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Object Storage (S3-совместимое) ---
# prod: Yandex Object Storage; dev: MinIO (endpoint http://localhost:9000)
S3_ENDPOINT_URL=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_ACCESS_KEY_ID=                   # статический ключ сервисного аккаунта
S3_SECRET_ACCESS_KEY=
S3_BUCKET=interviewer-media

# --- TTS (Yandex SpeechKit) — озвучка вопросов ---
SPEECHKIT_API_KEY=                  # можно тот же YANDEX_API_KEY
SPEECHKIT_FOLDER_ID=                # можно тот же YANDEX_FOLDER_ID

# =============================================================================
# ЭТАП 3 — пайплайн обработки: ASR.
# =============================================================================

# --- ASR (Yandex SpeechKit async) — транскрибация ответов ---
# Использует SPEECHKIT_API_KEY / SPEECHKIT_FOLDER_ID выше.
# Пользовательский словарь терминов задаётся на вакансию в БД, не здесь.

# =============================================================================
# Секреты САМИХ ассистентов (claude/codex) сюда НЕ кладём — это логин
# инструмента (claude login / codex login) или ANTHROPIC_API_KEY / OPENAI_API_KEY
# в окружении оболочки. См. README / CLAUDE.md.
# =============================================================================
