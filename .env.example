# =============================================================================
# .env.example — шаблон секретов проекта «ИИ-интервьюер».
# Скопируй в .env и заполни значения. .env в git НЕ коммитится.
# Порядок = порядок этапов из PRD (раздел 9): заводи по мере надобности.
# =============================================================================

# --- Общее ---
APP_ENV=development                 # development | production
CORS_ORIGINS=["http://localhost:5173"]   # origins фронтенда, JSON-список
SECRET_KEY=change-me                # общий секрет приложения
JWT_SECRET_KEY=change-me            # подпись JWT для внутренних ролей
MAGIC_LINK_SECRET=change-me         # подпись одноразовых ссылок кандидата (Р20)

# =============================================================================
# ЭТАП 1 — ядро оценки. Минимум для запуска: LLM (OpenAI) + Postgres.
# =============================================================================

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://interviewer:interviewer@localhost:5432/interviewer
DATABASE_ECHO=false                 # true — логировать SQL (только для отладки)

# --- LLM через OpenRouter (OpenAI-совместимый протокол) ---
# Модели open-source (Apache 2.0), self-hostable, с русским и structured outputs.
OPENAI_API_KEY=                     # ключ OpenRouter (sk-or-v1-...) с openrouter.ai/keys
OPENAI_BASE_URL=https://openrouter.ai/api/v1   # свой OpenAI-совместимый endpoint — меняй здесь
LLM_MODEL=qwen/qwen3-next-80b-a3b-instruct        # оценка/генерация: 80B, ~3B active
LLM_FAST_MODEL=qwen/qwen3-30b-a3b-instruct-2507   # горячий путь: 30B, ~3.3B active — мин. latency

# =============================================================================
# ЭТАП 2 — интервью кандидата: очередь, TTS, хранилище записей.
# =============================================================================

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Object Storage (S3-совместимое) ---
# prod: AWS S3; dev: MinIO (endpoint http://localhost:9000)
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=                   # статический ключ сервисного аккаунта
S3_SECRET_ACCESS_KEY=
S3_BUCKET=interviewer-media

# --- Голос (ASR/TTS): OpenRouter аудио НЕ отдаёт — отдельный провайдер ---
# OpenAI напрямую (sk-...) или self-hosted Whisper. Нужно с Этапа 2-3.
AUDIO_API_KEY=                      # ключ аудио-провайдера
AUDIO_BASE_URL=https://api.openai.com/v1
ASR_MODEL=whisper-1                 # транскрипт ответов с таймкодами (evidence)
TTS_MODEL=tts-1                     # озвучка вопросов (низкая задержка)
TTS_VOICE=alloy

# =============================================================================
# ЭТАП 3 — пайплайн обработки: ASR.
# =============================================================================

# ASR использует ASR_MODEL / OPENAI_API_KEY выше.

# =============================================================================
# Секреты САМИХ ассистентов (claude/codex) сюда НЕ кладём — это логин
# инструмента (claude login / codex login) или ANTHROPIC_API_KEY (для codex — OPENAI аккаунт отдельно)
# в окружении оболочки. См. README / CLAUDE.md.
# =============================================================================
